# ModelSim simulation artifacts
# Everything below is (re)generated by a simulation run. The sim_run.do flow in
# each sim folder is the reproducible source of truth, so session logs, compile
# reports and wave dumps must never be committed. Patterns have no leading '/'
# so they apply at every folder depth.
work/
transcript*
sim_transcript.log
modelsim.ini
*.wlf
wlf*
_vmake
_info
*.mpf
*.cr.mti

# Quartus incremental compilation
incremental_db/
db/
output_files/
simulation/
*.qws

# Backup files
*.bak
*.vhd.bak

# OS files
Thumbs.db
.DS_Store
