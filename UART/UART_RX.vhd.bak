library ieee;
use ieee.std_logic_1164.all;
use ieee.numeric_std.all;

entity UART_RX is
    generic (
        G_CLK_FREQ : natural := 50_000_000;
        G_BAUD     : natural := 115_200
    );
    port (
        clk : in  std_logic;
        rst_n : in  std_logic;
        r : in  std_logic;
        data_in : in  std_logic;
        rx_valid : out std_logic;
        data_rx : out std_logic_vector(7 downto 0);
        rx_busy : out std_logic
    );
end entity UART_RX;

architecture rtl of UART_RX is

    constant C_DIVIDER : natural := G_CLK_FREQ / G_BAUD;
    
    signal baud_tick : std_logic;
    signal shift : std_logic;
    signal baud_enable : std_logic;
    signal count : natural range 0 to 7 := 0;

    type state_t is (IDLE, WAIT_START_BIT, DATA_BITS, STOP_BIT);     
    signal state: state_t;
    signal nstate: state_t;

begin

    u_brg : entity work.baudrate_gen(rtl)
        port map (
            clk => clk,
            rst_n => rst_n,
            enable => baud_enable,
            divider => C_DIVIDER,
            baud_tick => baud_tick
        );

    u_s2p : entity work.serial_to_parallel(rtl)
        port map (
            clk => clk,
            rst_n => rst_n,
            shift => shift,
            data_in => data_in,
            data_out => data_rx
        );

    -- Sequential logic

    process(clk)
    begin
        if rising_edge(clk) then
            if rst_n = '0' then
                state <= IDLE;
                count <= 0;
            else
                state <= nstate;

                if baud_tick = '1' then
                    if state = DATA_BITS then
                        if count = 7 then
                            count <= 0;
                        else
                            count <= count + 1;
                        end if;
                    end if;
                end if;
            end if;
        end if;
    end process;

    -- Combinatorial logic

    rx_busy <= '1' when state /= IDLE else '0';
    baud_enable <= '1' when state /= IDLE else '0';

    process(all)                
        nstate <= state;                  
        rx_valid <= '0';
        shift <= '0';
        case state is
            when IDLE => 
                if r = '1' then 
                    nstate <= WAIT_START_BIT; 
                end if;
            when WAIT_START_BIT =>
                if data_in = '0' then
                    nstate <= DATA_BITS; 
                end if;
            when DATA_BITS =>
                if baud_tick = '1' then
                    shift <= '1';
                    if count = 7 then
                        nstate <= STOP_BIT;
                    end if;
                end if;
            when STOP_BIT =>
                if baud_tick = '1' then
                    rx_valid <= '1';
                    nstate <= IDLE;
                end if;
        end case;
    end process;

end architecture rtl;